<script>
// =========== Demo 1: 收訊端 ===========
let demo1Timeouts = [];

function trigger() {
  document.getElementById('trigger-btn').disabled = true;
  document.getElementById('trigger-btn').innerText = '發送中...';

  demo1Timeouts.push(setTimeout(() => {
    document.getElementById('p1').style.opacity = '1';
    document.getElementById('p1-bubble').style.display = 'block';
  }, 500));
  demo1Timeouts.push(setTimeout(() => {
    document.getElementById('p2').style.opacity = '1';
    document.getElementById('p2-bubble').style.display = 'block';
  }, 1500));
  demo1Timeouts.push(setTimeout(() => {
    document.getElementById('p3').style.opacity = '1';
    document.getElementById('p3-bubble').style.display = 'block';
  }, 2500));
  demo1Timeouts.push(setTimeout(() => {
    document.getElementById('p4').style.opacity = '1';
    document.getElementById('p4-bubble').style.display = 'block';
  }, 3500));
  demo1Timeouts.push(setTimeout(() => {
    document.getElementById('p2-status').style.display = 'block';
  }, 4500));
  demo1Timeouts.push(setTimeout(() => {
    document.getElementById('p3-status').style.display = 'block';
  }, 5500));
  demo1Timeouts.push(setTimeout(() => {
    document.getElementById('p4-failed').style.display = 'block';
    document.getElementById('p4').style.borderColor = '#d85a30';
  }, 6500));
  demo1Timeouts.push(setTimeout(() => {
    document.getElementById('p4-escalate').style.display = 'block';
  }, 7800));
  demo1Timeouts.push(setTimeout(() => {
    document.getElementById('p4-status').style.display = 'block';
    document.getElementById('p4').style.borderColor = '#4a8a4a';
  }, 9500));
  demo1Timeouts.push(setTimeout(() => {
    document.getElementById('summary').style.display = 'block';
    document.getElementById('trigger-btn').innerText = '✓ 全部送達';
  }, 10500));
}

function confirmReceived(id) {
  document.getElementById(id + '-ack').style.display = 'none';
  document.getElementById(id + '-status').style.display = 'block';
}

function resetAll() {
  demo1Timeouts.forEach(t => clearTimeout(t));
  demo1Timeouts = [];
  ['p1','p2','p3','p4'].forEach(id => {
    document.getElementById(id).style.opacity = '0.5';
    document.getElementById(id).style.borderColor = '#e8d5b7';
    document.getElementById(id + '-bubble').style.display = 'none';
    const status = document.getElementById(id + '-status');
    if (status) status.style.display = 'none';
  });
  document.getElementById('p1-ack').style.display = 'inline-block';
  document.getElementById('p4-failed').style.display = 'none';
  document.getElementById('p4-escalate').style.display = 'none';
  document.getElementById('summary').style.display = 'none';
  document.getElementById('trigger-btn').disabled = false;
  document.getElementById('trigger-btn').innerText = '▶ 開始發送';
}

// =========== Demo 2: 儀表板 ===========
let demo2Timeouts = [];
let playing = false;

const events = [
  { t: 1000, clock: "02:43:00", log: { type: "data", text: "📡 GAS Time Trigger 啟動 · 拉取水利署 IoW OpenData" } },
  { t: 2500, clock: "02:43:15", log: { type: "data", text: "🔍 比對:上次 0.42m(綠) → 這次 0.58m(綠) · 無變化" } },
  { t: 4000, clock: "02:45:00", water: 0.45, level: "watch", log: { type: "warn", text: "⚡ 比對:0.58m → 1.12m,跨越「滿管」閾值" } },
  { t: 5500, clock: "02:45:05", log: { type: "event", text: "📦 生成事件物件 evt_4hu05_20260601_024500 · 寫入 Sheets" } },
  { t: 7000, clock: "02:45:08", log: { type: "ai", text: "🤖 AI 守門員:對照鄰近三站 + 雨量趨勢 → 信心 92(真警報)" } },
  { t: 8500, clock: "02:45:12", log: { type: "ai", text: "🤖 AI 分流員:該里里長(LINE)+ 值班人員(SMS)+ 鎮公所(Email)" } },
  { t: 10000, clock: "02:45:15", log: { type: "ai", text: "🤖 AI 改寫員:里長版「四湖 05 站積水中,請查看」(口語)" } },
  { t: 11500, clock: "02:45:18", log: { type: "push", text: "📲 LINE → 王里長 · 已發送" } },
  { t: 13000, clock: "02:45:25", log: { type: "push", text: "📲 SMS → 值班人員 · 已發送" } },
  { t: 14500, clock: "02:45:32", log: { type: "push", text: "📲 Email → 鎮公所災防窗口 · 已發送" } },
  { t: 16000, clock: "02:48:00", water: 0.7, level: "critical", log: { type: "alert", text: "🔴 跨越「溢出路面」閾值 · 自動升級事件等級" } },
  { t: 17500, clock: "02:50:00", log: { type: "check", text: "⏱ 抵達確認:值班人員已按「收到」(02:46:12)" } },
  { t: 19000, clock: "02:50:30", log: { type: "fallback", text: "⚠️ 王里長未在 5 分鐘內回應 → 自動升級電話通知" } },
  { t: 20500, clock: "02:51:00", log: { type: "done", text: "✅ 全部抵達確認完成 · 事件納入單一真相紀錄" } },
];

function startDemo() {
  if (playing) return;
  playing = true;
  resetDemo(false);
  document.getElementById('play-btn').innerText = '▶ 播放中...';
  document.getElementById('play-btn').style.opacity = '0.6';
  const logEmpty = document.getElementById('log-empty');
  if (logEmpty) logEmpty.remove();

  events.forEach((e) => {
    const id = setTimeout(() => applyEvent(e), e.t);
    demo2Timeouts.push(id);
  });

  const finalId = setTimeout(() => {
    document.getElementById('play-btn').innerText = '✓ 完成,可重來';
    document.getElementById('play-btn').style.opacity = '1';
    document.getElementById('export-row').style.display = 'block';
    playing = false;
  }, 22000);
  demo2Timeouts.push(finalId);
}

function applyEvent(e) {
  if (e.clock) document.getElementById('clock').innerText = e.clock;

  if (e.water !== undefined) {
    document.getElementById('water-fill').style.height = (e.water * 100) + '%';
    document.getElementById('water-value').innerText = (e.water * 2.5).toFixed(2) + ' m';
    if (e.level === 'watch') {
      document.getElementById('water-fill').style.background = 'linear-gradient(180deg, #ba7517 0%, #854f0b 100%)';
      const pill = document.getElementById('status-pill');
      pill.innerText = '● 滿管';
      pill.style.background = '#3d2a0a';
      pill.style.color = '#f5c842';
    }
    if (e.level === 'critical') {
      document.getElementById('water-fill').style.background = 'linear-gradient(180deg, #e24b4a 0%, #791f1f 100%)';
      const pill = document.getElementById('status-pill');
      pill.innerText = '● 溢出路面';
      pill.style.background = '#4d1a1a';
      pill.style.color = '#ff7a7a';
    }
  }

  if (e.log) {
    const colors = {
      data: '#6b7a8c', warn: '#f5c842', event: '#7fb3f0', ai: '#c79df0',
      push: '#5fd9a3', alert: '#ff7a7a', check: '#5fd9a3', fallback: '#f5c842', done: '#5fd9a3'
    };
    const item = document.createElement('div');
    item.className = 'log-item';
    item.style.borderLeft = '2px solid ' + colors[e.log.type];
    const time = document.createElement('span');
    time.className = 'log-time';
    time.style.color = colors[e.log.type];
    time.innerText = document.getElementById('clock').innerText;
    const text = document.createElement('span');
    text.className = 'log-text';
    text.innerText = e.log.text;
    item.appendChild(time);
    item.appendChild(text);
    document.getElementById('log-content').appendChild(item);
    requestAnimationFrame(() => { item.style.opacity = '1'; });
    document.getElementById('event-log').scrollTop = 99999;
  }
}

function resetDemo(full) {
  demo2Timeouts.forEach(t => clearTimeout(t));
  demo2Timeouts = [];
  playing = false;
  document.getElementById('clock').innerText = '02:42:30';
  document.getElementById('water-fill').style.height = '25%';
  document.getElementById('water-fill').style.background = 'linear-gradient(180deg, #2d7a5c 0%, #1a4d3a 100%)';
  document.getElementById('water-value').innerText = '0.42 m';
  const pill = document.getElementById('status-pill');
  pill.innerText = '● 半滿管';
  pill.style.background = '#1a4d3a';
  pill.style.color = '#5fd9a3';
  if (full !== false) {
    document.getElementById('log-content').innerHTML = '<div class="log-empty" id="log-empty">按下播放,看半夜這 15 分鐘內,系統做了什麼</div>';
    document.getElementById('export-row').style.display = 'none';
    document.getElementById('export-preview').style.display = 'none';
    document.getElementById('play-btn').innerText = '▶ 播放半夜這場雨';
    document.getElementById('play-btn').style.opacity = '1';
  }
}

function showExport(format) {
  const samples = {
    EMIC: '<EMICEvent>\n  <EventID>evt_4hu05_20260601_024500</EventID>\n  <Station>四湖05</Station>\n  <Level>CRITICAL</Level>\n  <Timestamp>2026-06-01T02:48:00+08</Timestamp>\n  <ReportTo>雲林縣政府災害應變中心</ReportTo>\n</EMICEvent>',
    CAP: '{\n  "identifier": "evt_4hu05_20260601_024500",\n  "sender": "bright-pipe@civictech.tw",\n  "category": "Met",\n  "urgency": "Immediate",\n  "severity": "Severe",\n  "headline": "四湖鄉雨水下水道溢出路面"\n}',
    CSV: '事件編號,站點,時間,狀態,水位\nevt_4hu05_20260601_024500,四湖05,02:48:00,溢出路面,1.75m',
    JSON: '{\n  "event_id": "evt_4hu05_20260601_024500",\n  "station": "四湖05",\n  "change": "watch → critical",\n  "value": 1.75,\n  "unit": "m",\n  "ai_confidence": 92\n}'
  };
  const el = document.getElementById('export-preview');
  el.innerText = samples[format];
  el.style.display = 'block';
}
